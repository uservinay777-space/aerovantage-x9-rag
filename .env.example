# AeroVantage X9 RAG Environment Variables
# Vector DB & Ingestion
CHROMA_DIR=./chroma_db
COLLECTION_NAME=aerovantage_x9_manual
PDF_PATH=data/aerovantage_x9_drone_manual_50p.pdf
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=6

# LLM Providers (Configure at least one for generative responses)
# 1. Groq (Fast & Free Tier available)
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# 2. OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# 3. Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here
